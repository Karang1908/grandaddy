{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grandaddy",
  "version": "0.3.0",
  "identifier": "dev.grandaddy.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Grandaddy",
        "width": 1240,
        "height": 800,
        "minWidth": 920,
        "minHeight": 580,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "backgroundColor": "#fbf8f3"
      },
      {
        "label": "quick",
        "title": "Grandaddy",
        "url": "quick.html",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "ask",
        "title": "Grandaddy",
        "url": "ask.html",
        "width": 420,
        "height": 540,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Manage your vibe coding sessions. All in one place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/grandaddy"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
